# FileForge runs with ZERO configuration: `npm install && npm run dev`.
# Every variable below is OPTIONAL and only read when its feature is used.
# Server-only variables — never prefix secrets with NEXT_PUBLIC_.

# Public site URL used for canonical links, sitemap and Open Graph (defaults to http://localhost:3000).
NEXT_PUBLIC_SITE_URL=

# Optional server conversion engines. Tools that need them show as unavailable until set.
# Absolute paths to the executables on the server.
LIBREOFFICE_PATH=
QPDF_PATH=
GHOSTSCRIPT_PATH=

# Server upload limit in megabytes (default 200). Temporary files are deleted after
# TEMP_FILE_TTL_MINUTES (default 60).
MAX_UPLOAD_MB=
TEMP_FILE_TTL_MINUTES=

# Optional AI enhancements (not used by any core feature; leave empty).
AI_PROVIDER=
AI_API_KEY=
