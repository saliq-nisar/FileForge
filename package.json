    "next": "16.3.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.15"
